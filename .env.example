# ================================================================
# REVIEWS SORTED (YII 3) — ENVIRONMENT CONFIGURATION TEMPLATE
# ================================================================
# Copy this file to .env and adjust values for your environment.
# Never commit real credentials, production secrets, or private keys.

# --- Application Core ---
# Valid environments: local, dev, staging, prod, production
APP_ENV=prod
# Set to false in staging and production to prevent debug information leakage
APP_DEBUG=false
APP_NAME="Reviews Sorted"
APP_TIMEZONE=Australia/Perth

# --- Application URLs & Routing ---
# When deployed at domain root (e.g. https://app.example.com), set APP_BASE_PATH="" or "/"
# When deployed in a subdirectory (e.g. https://example.com/sys-yii3), set APP_BASE_PATH="/sys-yii3"
APP_URL=https://app.example.com
APP_BASE_PATH=

FRONTEND_URL=https://app.example.com
BACKEND_URL=https://app.example.com
API_BASE_URL=https://app.example.com/accountapi
ASSET_BASE_URL=/assets

# --- Server & Filesystem Directories ---
PUBLIC_DIR=@root/public
RUNTIME_DIR=@root/runtime
STORAGE_DIR=@root/runtime/storage
UPLOAD_DIR=@root/public/assets/qr

# --- Database Connection ---
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sortedreviews_prod
DB_USER=rs_app_user
DB_PASSWORD=your_secure_db_password_here
DB_CHARSET=utf8mb4
DB_TABLE_PREFIX=

# --- Email & SMTP Gateway ---
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="Reviews Sorted"
MAILGUN_ENABLED=false
MAILGUN_API_KEY=your_mailgun_api_key
MAILGUN_DOMAIN=example.com
MAILGUN_ENDPOINT=https://api.eu.mailgun.net

# --- Meta WhatsApp Cloud API ---
WHATSAPP_ENABLED=false
WHATSAPP_TOKEN=your_meta_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
WHATSAPP_API_VERSION=v18.0

# --- Stripe Billing & Subscriptions ---
# Mode: "test" or "live"
STRIPE_MODE=test
STRIPE_TEST_PUBLIC_KEY=pk_test_sample
STRIPE_TEST_SECRET_KEY=sk_test_sample
STRIPE_TEST_WEBHOOK_SECRET=whsec_sample
STRIPE_LIVE_PUBLIC_KEY=pk_live_sample
STRIPE_LIVE_SECRET_KEY=sk_live_sample
STRIPE_LIVE_WEBHOOK_SECRET=whsec_sample

# --- Social Platform OAuth Credentials & Webhooks ---
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_REDIRECT_URI=https://app.example.com/settings/facebook/callback
FACEBOOK_VERIFY_TOKEN=your_facebook_verify_token_here

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://app.example.com/settings/google/callback

# --- QR Code Custom Landing & Development ---
# Optional custom base URL for generated QR code landing pages (e.g. https://reviews.to)
QR_CODE_GENERATION_BASE_URL=
# Whitelisted safe host replacement for localhost during development (default: sys.test)
LOCAL_QR_SAFE_HOST=sys.test

# --- WYSIWYG Editor ---
TINYMCE_LICENSE_KEY=gpl

# --- Session & Cookie Security ---
# Set SESSION_COOKIE_SECURE=true when running over HTTPS in production
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax
