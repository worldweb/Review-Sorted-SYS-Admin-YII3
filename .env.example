# ==========================================================
# REVIEWS SORTED (YII 3) — ENVIRONMENT CONFIGURATION TEMPLATE
# ==========================================================
# Copy this file to .env and configure values for your target
# environment (local development, staging, or production).
# Never commit real secrets or production credentials to Git.

# ==========================================================
# APPLICATION & ENVIRONMENT
# ==========================================================
# Environment mode: local (or dev) for development, prod (or production) / staging for servers
APP_ENV=local
# Enable debug output locally (true). MUST be false in production.
APP_DEBUG=true
# Required in production: 32-byte encryption/signing key (64 hex chars or base64:...)
APP_KEY=
# Application display name
APP_NAME="Reviews Sorted"
# Full base URL of the application (used for links, OAuth callbacks, and production checks)
# Local example: http://localhost/sys-yii3 | Production example: https://sys.reviewssorted.com
APP_URL=http://localhost/sys-yii3
# Subdirectory base path if hosted in a subfolder (e.g. /sys-yii3 locally, empty in root domain prod)
APP_BASE_PATH=/sys-yii3
# Default application timezone
APP_TIMEZONE=Australia/Perth
# Optional (Development-only): Host filesystem path mapping for IDE error handler links
APP_HOST_PATH=

# ==========================================================
# DATABASE
# ==========================================================
# Required in all environments
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_TABLE_PREFIX=

# ==========================================================
# SESSION & SECURITY
# ==========================================================
# Set false for HTTP localhost; MUST be true when APP_URL uses HTTPS in production
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax
# Optional: Comma-separated trusted reverse proxy IPs/CIDRs for rate-limiter IP resolution
TRUSTED_PROXIES=

# ==========================================================
# EMAIL / MAILGUN (CONDITIONAL)
# ==========================================================
# Mailgun is active whenever MAILGUN_API_KEY is non-empty (and not "disabled").
# Required for email queue sending and Mailgun delivery-status sync.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=reviewssorted.com
# EU region: https://api.eu.mailgun.net | US region: https://api.mailgun.net
MAILGUN_ENDPOINT=https://api.eu.mailgun.net
MAIL_FROM_ADDRESS=noreply@reviewssorted.com

# ==========================================================
# WHATSAPP CLOUD API (CONDITIONAL)
# ==========================================================
# WhatsApp is active whenever both WHATSAPP_TOKEN and WHATSAPP_PHONE_NUMBER_ID are non-empty.
# Legacy RS_WHATSAPP_ACCESS_TOKEN, RS_WHATSAPP_PHONE_NUMBER_ID, RS_WHATSAPP_API_VERSION
# are also supported as fallbacks.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v18.0
# Optional: Fallback Meta template name when sending outside the 24-hour customer service window
WHATSAPP_CAMPAIGN_TEMPLATE_NAME=

# ==========================================================
# FACEBOOK WEBHOOKS
# ==========================================================
# Note: Google and Facebook OAuth credentials (and Facebook App Secret for
# X-Hub-Signature-256 HMAC verification) are managed in the database `api` table,
# and OAuth redirect URIs are generated dynamically from APP_URL.
#
# Conditional: Required if Meta webhook GET handshakes (/hooks/messages) are active.
# Legacy RS_FACEBOOK_VERIFY_TOKEN is also supported as a fallback.
FACEBOOK_VERIFY_TOKEN=

# ==========================================================
# STRIPE PAYMENT CONFIGURATION
# ==========================================================

# Select payment mode: test or live
STRIPE_MODE=test

# Stripe TEST credentials
STRIPE_TEST_PUBLIC_KEY=
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=

# Stripe LIVE credentials
# Add actual Live credentials when configuring production.
STRIPE_LIVE_PUBLIC_KEY=
STRIPE_LIVE_SECRET_KEY=
STRIPE_LIVE_WEBHOOK_SECRET=

# ==========================================================
# QR CODE STUDIO
# ==========================================================
# Optional: Base URL for generated QR code links (e.g. https://sys.reviewssorted.com)
QR_CODE_GENERATION_BASE_URL=
# Development-only: Safe fallback host used when generating QR links on localhost
LOCAL_QR_SAFE_HOST=sys.test
