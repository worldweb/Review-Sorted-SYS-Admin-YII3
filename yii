#!/usr/bin/env php
<?php

declare(strict_types=1);

use App\Environment;
use Yiisoft\Yii\Runner\Console\ConsoleApplicationRunner;

require_once __DIR__ . '/src/bootstrap.php';

if (!Environment::cronLogEnabled() && PHP_SAPI === 'cli') {
    $argv = $_SERVER['argv'] ?? [];
    $isInteractive = function_exists('stream_isatty') && defined('STDOUT') && @stream_isatty(STDOUT);
    $hasVerboseFlag = false;
    foreach ($argv as $arg) {
        if ($arg === '--verbose' || $arg === '-v' || $arg === '-vv' || $arg === '-vvv' || str_starts_with((string) $arg, '--verbose=')) {
            $hasVerboseFlag = true;
            break;
        }
    }

    if (!$isInteractive && !$hasVerboseFlag && !in_array('--quiet', $argv, true) && !in_array('-q', $argv, true)) {
        array_splice($argv, 1, 0, ['--quiet']);
        $_SERVER['argv'] = $argv;
        $_SERVER['argc'] = count($argv);
    }
}

// Run console application runner
$runner = new ConsoleApplicationRunner(
    rootPath: __DIR__,
    debug: Environment::appDebug(),
    checkEvents: Environment::appDebug(),
    environment: Environment::appEnv(),
);
$runner->run();
